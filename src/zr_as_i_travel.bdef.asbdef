managed implementation in class zbp_r_as_i_travel unique;
strict ( 2 ); with draft;

define behavior for ZR_AS_I_TRAVEL alias travel
persistent table zas_travel
draft table zas_i_travel_d
lock master
total etag lastchangedat
authorization master ( instance )
etag master LastChangedAt
early numbering
{
  create ( authorization : global );
  update ( features : instance );
  delete;

  field ( readonly : update ) AgencyId;
  field ( readonly ) Status, LastChangedAt, TravelId;
  field ( mandatory ) Description, EndDate;
  field ( features : instance ) CustomerID, BeginDate;

  validation validateDescription on save { create; field Description; }
  validation validateCustomer on save { create; field CustomerID; }
  validation validateBeginDate on save { create; field BeginDate; }
  validation validateEndDate on save { create; field EndDate; }
  validation validateDataSequence on save
  {
    create;
    field BeginDate, EndDate;
  }

  determination determinestatus on modify { create; update; }

  static action issue_message;
  action ( features : instance ) cancel_travel;
  association _item { create; with draft; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateDescription;
    validation validateCustomer;
    validation validateBeginDate;
    validation validateEndDate;
    validation validateDataSequence;
    validation _item~validateflightdate;
  }

  mapping for zas_travel
  {
    TravelId      = travel_id;
    travel_uuid   = travel_uuid;  // Matched exactly to your CDS view component
    AgencyId      = agency_id;
    CustomerID    = customer_id;
    BeginDate     = begin_date;
    EndDate       = end_date;
    CurrencyCode  = currency_code;
    BookingFee    = booking_fee;
    TotalPrice    = total_price;
    Description   = description;
    Status        = status;
    LastChangedAt = last_changed_at;
  }
}

define behavior for ZI_AS_TRAVELITEM alias _item
persistent table zas_travelitem
draft table zas_travelitem_d
authorization dependent by _travel
lock dependent by _travel
etag master Lastchangedat
{
  update;
  delete;

  field ( numbering : managed, readonly ) ItemUuid;
  field ( readonly ) TravelUuid;
  field ( readonly : update ) AgencyId, TravelId;

  validation validateflightdate on save { create; update; field FlightDate; }

  determination copyParentKeys on modify { create; }

  association _travel { with draft; }

  mapping for zas_travelitem corresponding
  {
    ItemUuid           = item_uuid;
    TravelUuid         = travel_uuid;
    AgencyId           = agency_id;
    TravelId           = travelid;
    CarrierId          = carrier_id;
    ConnectionId       = connection_id;
    FlightDate         = flight_date;
    BookingId          = booking_id;
    PassengerFirstName = passenger_first_name;
    PassengerLastName  = passenger_last_name;
  }
}